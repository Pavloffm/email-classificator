TZ=Europe/Bratislava
RUN_TIMES=09:00,21:00
OLLAMA_BASE_URL=http://ollama-location-placeholder
OLLAMA_MODEL=gemma4:e4b

# Container mount destinations (host paths remain ./secrets and ./data).
EMAIL_SECRETS_DIR=/app/secrets
EMAIL_STATE_DIR=/app/data

# Set these to the host user's `id -u` and `id -g` before building.
# Both ./secrets and ./data must be writable by this UID/GID.
APP_UID=1000
APP_GID=1000
